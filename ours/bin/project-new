#!/usr/bin/env python3
"""Create a project board folder outside the code repository (TASK-K08a).

    project-new <name> --repo <path> --base <branch> --prefix <PREFIX> \
                --port <port> [--root <dir>]

Run it with the orchestrator's Python (the one that has `symphony`
installed): that interpreter and the `symphony` next to it go into
[tools]. Nothing is overwritten; on any refusal nothing is left behind.
"""

from __future__ import annotations

import argparse
import json
import shlex
import shutil
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "hooks"))

import project_config as pc  # noqa: E402

SETUP_SH = """\
#!/bin/bash
# OURS-STUB: заготовка. Удали эту строку и две последние (echo, exit), когда
# настроишь файл: project-doctor не пропустит файл с этой меткой.
# Подготовка свежей рабочей копии карточки (запускает ours/hooks/worktree.py
# через /bin/bash в папке рабочей копии, после `git worktree add`).
#
# ПРАВИЛО: инструменты — только полными путями. Служба запускается launchd с
# коротким PATH (/usr/bin:/bin:/usr/sbin:/sbin) без настроек терминала (nvm,
# brew, pyenv): всё, что работает только благодаря PATH терминала, ночью упадёт.
# project-doctor проверяет это: прогоняет скрипт с таким же коротким PATH.
# Первой строкой задай PATH и проверь версию, чтобы ошибка была видна сразу:
#   export PATH="/полный/путь/к/node/bin:$PATH"; node --version || exit 1
#   npm ci
# Пример для Python:
#   /полный/путь/python3 -m venv .venv && .venv/bin/pip install -e .
#
# ОКРУЖЕНИЕ СЛУЖБЫ БЕДНОЕ (замер на Mac, K13): PATH короткий, LANG и LC_ALL не
# заданы, TMPDIR выдаёт launchd; у агента и хуков в окружении лежат лишние
# переменные SYMPHONY_* службы. Если тесты проекта на них реагируют, в начале
# скрипта очисти их (оставь SYMPHONY_PYTHON и SYMPHONY_WORKFLOW_DIR) и при
# необходимости задай нужные переменные сам.
# Лимит открытых файлов (macOS даёт 256) для установки обычно не важен; если
# важен — `ulimit -n 10240` в начале скрипта.
# Код 0 = готово; любой другой код — рабочая копия и новая ветка убираются.
echo "setup.sh не настроен: заполни {board}/setup.sh" >&2
exit 1
"""

TEST_SH = """\
#!/bin/bash
# OURS-STUB: заготовка. Удали эту строку и две последние (echo, exit), когда
# настроишь файл: project-doctor не пропустит файл с этой меткой.
# Полный прогон тестов проекта (запускают ours/hooks/check.py и project-doctor
# через /bin/bash в папке рабочей копии, в своей группе процессов, с таймаутом
# [timeouts] tests_s). Раннер вызывать напрямую, полными путями.
#
# ПРАВИЛО: инструменты — только полными путями. Служба запускается launchd с
# коротким PATH (/usr/bin:/bin:/usr/sbin:/sbin) без настроек терминала (nvm,
# brew, pyenv): всё, что работает только благодаря PATH терминала, ночью упадёт.
# project-doctor проверяет это: прогоняет скрипт с таким же коротким PATH.
# Первой строкой задай PATH и проверь версию, чтобы ошибка была видна сразу:
#   export PATH="/полный/путь/к/node/bin:$PATH"; node --version || exit 1
#
# ОКРУЖЕНИЕ СЛУЖБЫ БЕДНОЕ (замер на Mac, K13): PATH короткий, LANG и LC_ALL не
# заданы, TMPDIR выдаёт launchd; у агента и хуков в окружении лежат лишние
# переменные SYMPHONY_* службы. Если тесты проекта на них реагируют, в начале
# скрипта очисти их (оставь SYMPHONY_PYTHON и SYMPHONY_WORKFLOW_DIR) и при
# необходимости задай нужные переменные сам.
# ЛИМИТ ОТКРЫТЫХ ФАЙЛОВ: macOS даёт 256 по умолчанию, большому набору тестов
# этого мало (на пробе были массовые падения и «unable to open database file»).
# Если так — подними лимит в начале скрипта: ulimit -n 10240
#
# ТЕСТЫ С ТАЙМИНГОМ (проверяют время) под нагрузкой флейкают. Если такие есть,
# запусти их отдельным последовательным проходом после основного (свой отчёт
# JUnit, оба отчёта — в summarize.py одним вызовом: он сложит счётчики).
# Агент должен гонять только этот test.sh, не раннер напрямую.
#
# Код 0 = зелено. В конце обязательна строка итогов (считается последняя):
#   PIPELINE_TESTS passed=<n> skipped=<n> failed=<n>
# Её печатает summarize.py по отчёту JUnit XML. Отчёт — во временный файл вне
# рабочей папки, чтобы он не попал в git. Пример:
#
# report="$(mktemp -t ours-junit.XXXXXX)"; trap 'rm -f "$report"' EXIT
# # Vitest:
# /полный/путь/node_modules/.bin/vitest run --reporter=junit --outputFile="$report"
# # pytest:
# .venv/bin/python -m pytest -q --junitxml="$report"
# rc=$?
# "$SYMPHONY_PYTHON" {summarize} "$report" || exit $(( rc ? rc : 1 ))
# exit $rc
# Несколько проходов: два отчёта, одна строка итогов, код — первый ненулевой:
# "$SYMPHONY_PYTHON" {summarize} "$report" "$report_timing" || exit $(( rc ? rc : 1 ))
echo "test.sh не настроен: заполни {board}/test.sh" >&2
exit 1
"""

CARD_TEMPLATE = """\
---
# Образец карточки (TASK-K14). Сюда ничего не попадает само: скопируй текст в
# новую карточку на доске ({board}/kanban/<ID>.md или `symphony board new`).
id: {prefix}-N
title: Короткое название задачи
state: Todo
# Уровень описывает сложность задачи (раздел [levels] в project.toml); модель и
# усилие берутся из перевода уровня для бэкенда. Назначает тот, кто нарезает задачу.
# Не знаешь — убери строку, тогда действует default_level. Неизвестный уровень
# отправит карточку в Blocked.
level: simple
---

Уровень: simple — почему такой (одна фраза: чем задача проста или сложна)

Что сделать: ...

Критерии приёмки:
- AC1: ...

Тесты только через `/bin/bash {board}/test.sh`, по одной команде на вызов Bash, без `&&`, `;`, `|`.
"""

PROJECT_TOML = """\
# Настройки проекта для конвейера (TASK-K08a, K08b). Единственный файл настроек:
# WORKFLOW.md строится из него командой ours/bin/project-render.
# Неизвестный ключ — ошибка, чтобы опечатка не отключила проверку.

[project]
name = {name}
repo = {repo}            # репозиторий кода, абсолютный путь
base_branch = {base}     # от неё создаются ветки symphony/<ID>
id_prefix = {prefix}     # ID карточек: {prefix_raw}-1, {prefix_raw}-2, ...
port = {port}

[tools]                  # абсолютные пути; заполняет project-new
python = {python}
symphony = {symphony}
claude = {claude}

[checks]                 # правила ours/hooks/check.py
# forbidden_paths = []         # ДОБАВЛЯЮТСЯ к встроенному списку; сюда же
#                              # файлы запуска тестов (package.json, конфиг раннера)
# test_globs = ["tests/**"]    # ЗАМЕНЯЮТ встроенный список
# allow_modified_tests = []
# required_sections = ["## Wiki Updates", "## As-Is -> To-Be Report"]
# worker_required_sections = ["## QA Evidence", "## Merge Status"]
#                              # то же для подзадачи ([integration] enabled = true, метка
#                              # worker_label и поле `request:`): у неё нет этапа Document,
#                              # wiki и отчёт пишет карточка задачи; эти разделы пишет Verify
# doc_paths = ["docs/our/**/*.md"]
#                              # пути, правка которых не требует полного прогона тестов
#                              # (все изменённые пути должны совпасть с этим списком;
#                              # быстрые проверки идут всегда). Включать только то, что
#                              # тесты точно не читают (например, `CHANGELOG.md` у форка
#                              # читает тест — его сюда нельзя); лучше ограничивать
#                              # расширением `.md` — тогда файл кода в такой папке не
#                              # пройдёт без тестов. Перед доставкой задачи полный прогон
#                              # всё равно будет
max_check_failures = 2         # провалов проверки check.py до needs_human: второй
#                              # провал (откат из Human Review в In Progress) — стоп

# Какие файлы меняют то, что измеряют тесты (E2). Раздел необязателен. По этому правилу
# post-merge решает, перемерять ли базу после слияния (project-doctor), а check.py — верить
# ли старому замеру базы (он недействителен, если между ним и точкой ответвления карточки
# менялся такой файл). Без раздела действует питоновское правило: папки tests/ и
# ours/tests/; файлы conftest.py, pytest.ini, pyproject.toml, uv.lock, package.json,
# package-lock.json; файлы test_*.py, *_test.py и conftest.py на любой глубине. Для
# проекта на другом языке оно не подходит (правка конфига тестов осталась бы незамеченной).
# С разделом paths ЗАМЕНЯЕТ правило целиком, а не дополняет: питоновских шаблонов проект
# не наследует. Шаблоны — от корня репозитория кода, того же вида, что forbidden_paths
# (* внутри одного имени, ** через любое число папок), без ведущего / и без `..`.
# Каждый шаблон из [checks] test_globs (или из встроенного списка, если test_globs не
# задан) обязан стоять в paths буквально — иначе project.toml не принимается: файл,
# защищённый как тест, обязан и вызывать перемер, и обесценивать старый замер.
# Пример для Vitest (vitest.* — конфиг, файлы подготовки, workspace):
# [baseline]
# paths = ["tests/**", "**/*.test.ts", "**/*.test.tsx", "**/*.spec.*", "vitest.*",
#          "vite.config.*", "package.json", "package-lock.json", ".nvmrc", "tsconfig*.json"]
# и в [checks]: test_globs = ["tests/**", "**/*.test.ts", "**/*.test.tsx", "**/*.spec.*"]
#   (иначе к paths нужно добавить и питоновские/Go-шаблоны умолчания: **/test_*.py, **/*_test.py, **/*_test.go)

[agent]                  # права агента (K13)
# Дополнительные разрешения для Bash агента к встроенной базе (/bin/bash <доска>/test.sh,
# git merge-tree, test, echo, cat, wc, head, tail). Команда без обёртки Bash(...),
# совпадение по началу. Без этого `claude -p` отклоняет всё, что вне списка, и агент
# крутится до max_turns. Составные команды (&&, ;, |) проходят, только если разрешена
# каждая часть. Нельзя: пустые записи, одиночный *, Bash(*), bash/sh/env и всё, что
# похоже на отключение проверок разрешений.
# allowed_bash = [".venv/bin/python -m ruff"]
# Сколько агентов работают одновременно (умолчание 1). При [integration] enabled = true
# должно быть 1: вливание и Done подзадачи рассчитаны на одного агента (одно вливание
# за раз), иначе project.toml не принимается.
# max_concurrent_agents = 1
# Папки рабочей копии, в которые агент не пишет встроенными инструментами (Edit, Write) и
# перенаправлениями: тесты и проверки запускают их код, а правка там не видна в диффе.
# Пути от корня рабочей копии, без шаблонов. Умолчание — node_modules и .venv.
# protected_dirs = ["node_modules", ".venv"]
# Файл правил проекта в репозитории кода (путь от корня). Строка «читай его первым» попадает в
# промпт всех этапов; файл должен быть на базовой ветке (project-doctor проверяет). Без ключа
# правил проекта в промпте нет.
# project_rules = "docs/agent-rules.md"
# Карта проекта для руководителя: строка «прочитай перед планом» только в промпте этапа Plan.
# manager_rules = "docs/project-map.md"

[integration]            # интеграционная ветка задачи (S4-11); пока выключено
# Подзадачи одной задачи (карточки с меткой worker_label и полем `request: <ЗАДАЧА>`)
# стартуют не от базовой ветки, а от конца общей ветки задачи, чтобы видеть код друг
# друга. Ветку создаёт `ours/hooks/integrate.py ensure-branch <ЗАДАЧА>` или, если её
# ещё нет, worktree.py при старте первой подзадачи. Готовую подзадачу в конце хода
# вливает integrate.py hook (S4-12) и сам ставит ей Done; нужен max_concurrent_agents = 1.
# Без раздела и при false всё как раньше.
# enabled = false
# branch_prefix = "integration/"   # на /; не symphony/ и не attempts/ (их занял хук)
# worker_label = "role:worker"     # без учёта регистра

[plan]                   # нарезка задачи на подзадачи (S4-19); умолчания подходят
# Руководитель (карточка с меткой role:manager-plan, статус Plan) пишет план-файл
# docs/<ЗАДАЧА>/work/plan.toml и сдаёт его переводом карточки в Subtasks. Хук
# ours/hooks/plan.py проверяет план и сам создаёт карточки подзадач (ни одной, если в
# плане есть ошибка: карточка возвращается в Plan с разделом `## Plan Failure`).
# При сбое создания журнал и карточки в Subtasks сохраняются; продолжение той же
# операции без агента: plan.py recover <ЗАДАЧА> --board <папка-доски> (S4-32).
# Работает при включённой интеграции и непустом разделе уровней (ниже).
# max_subtasks = 5       # подзадач в плане не больше (от 1 до 20)
# max_subtask_level = "simple"  # необязательно: имя объявленного уровня; только понижает потолок задачи
# max_failures = 2       # сколько раз план можно вернуть на доработку; после этого
#                        # карточка уходит в needs_human

# Доставка результата карточки на GitHub (S4-27): команда очереди `<ID>.deliver` собирает
# ветку deliver/<ID>, пушит её по явному адресу репозитория и открывает PR. Раздел
# необязателен; без него доставка этой доски отказывает «нет раздела [delivery]». Оба
# ключа обязательны; base должна совпадать с [project] base_branch. Владелец cskwork
# (исходный проект автора) запрещён всегда. Раскомментируй и впиши свой форк:
# [delivery]
# repo = "владелец/имя"     # только буквы, цифры и . _ - ; например "Serg10011/oh-my-symphony"
# base = "our-main"         # ветка, в которую открывается PR

[service]                # служба под launchd (ours/bin/project-launchd)
# model = "haiku"              # переменная ANTHROPIC_MODEL службы; без ключа не задаётся

# Оплата ходов агента (E1b). Раздел необязателен; без него — подписка, как всегда.
#   mode = "plan"  — ходы идут в лимит подписки (вход пользователя в claude); умолчание.
#   mode = "api"   — ходы оплачиваются API-кредитом: ключ рабочего пространства Console,
#                    который claude получает только через apiKeyHelper из файла
#                    <доска>/claude-settings.json (его пишет project-render). Когда кредит
#                    кончается, одна карточка уходит в needs_human с разделом
#                    `## Quota Exhausted`, остальные ждут: служба не берёт новые, пока
#                    WORKFLOW.md не пересобран. Сама доска на подписку не переключается.
# Как включить API-кредит:
#   1. В Console создай рабочее пространство этой доски и задай ему потолок трат
#      (обязательно: это часть страховки); создай в нём ключ.
#   2. Папка только для ключей (не домашняя и не внутри репозитория, доски, рабочих копий
#      или папки форка): install -d -m 700 ~/.symphony-keys
#      Файл: install -m 600 /dev/null ~/.symphony-keys/<имя доски>.key
#      затем вставь ключ в файл редактором (в чат, в карточки и в git ключ не попадает).
#   3. Раскомментируй раздел, впиши абсолютный путь и запусти ours/bin/project-render <имя>.
# Как вернуться на подписку: mode = "plan" (строку api_key_file можно оставить), затем
# ours/bin/project-render <имя>: ключ и помощник из claude-settings.json уйдут (сам файл
# остаётся: запреты на правку и таймаут Bash нужны в обоих режимах). Переменные
# ANTHROPIC_API_KEY и ANTHROPIC_AUTH_TOKEN в окружении службы запрещены (project-doctor: FAIL).
# [billing]
# mode = "api"
# api_key_file = "/Users/<ты>/.symphony-keys/<имя доски>.key"   # абсолютный путь, без ..

[timeouts]               # заполняет project-doctor по замеру; пока — умолчания
# tests_s = 900                # таймаут test.sh (check.py hook и gate)
# gate_ms = 960000             # agent.done_gate_timeout_ms = (tests_s + 60) * 1000
# hooks_ms = 1200000           # hooks.timeout_ms: setup.sh и after_run
#                              # stall_timeout_ms (сторож зависания) считает шаблон:
#                              # max(300 с, tests_s + 120 с)
# fixed = true                 # project-doctor не перезаписывает, только советует

[levels]                 # уровни задач (TASK-K14, S4-15): сложность задачи
# Уровень описывает задачу; модель и усилие — перевод уровня для бэкенда, у каждого
# бэкенда своя шкала ([levels.<имя>.claude], [levels.<имя>.codex]).
# Карточка выбирает уровень строкой `level: standard` во frontmatter; без неё действует
# default_level. Уровень назначает тот, кто нарезает задачу, и пишет в карточке,
# почему такой. Неизвестный уровень в карточке — карточка уходит в Blocked с
# пояснением, на модель по умолчанию она не откатывается. Значения стартовые,
# уточняются по статистике (журнал службы пишет уровень, модель и усилие каждого хода).
# Порядок уровней — порядок, в котором они объявлены ниже (от простого к сложному):
# подзадача не может иметь уровень выше уровня своей задачи (проверяет plan.py).
# Усилие claude: low, medium, high, xhigh, max. Имена моделей проверяет сам claude.
# Модель из уровня (--model) важнее ключа model из раздела service; тот остаётся
# запасным для карточек без уровня (когда default_level не задан).
default_level = "simple"

[levels.simple]          # простая задача
[levels.simple.claude]
model = "haiku"
effort = "medium"

[levels.standard]        # обычная задача (та же модель, усилие выше)
[levels.standard.claude]
model = "haiku"
effort = "high"

[levels.complex]         # сложная задача
[levels.complex.claude]
model = "sonnet"
effort = "high"

[levels.critical]        # критическая: самая трудная, цена ошибки высока
[levels.critical.claude]
model = "sonnet"
effort = "max"

# Свои лимиты ходов у уровня (необязательно; подменяют max_turns и max_state_turns
# из раздела limits для карточек этого уровня; max_total_turns и max_attempts общие).
# Пример для будущей локальной модели: она бесплатная, её ограничивает только
# время, поэтому лимиты щедрее облачных:
# [levels.LOCAL]
# max_turns = 40               # не меньше 4 × (1 + max_attempts), как у проекта в целом
# max_state_turns = 6

[limits]                 # лимиты ходов; строгие, для облачных моделей (раздел agent в WORKFLOW.md)
# Ход — один запуск агента с заданием этапа (внутри хода агент делает много
# действий). Нормальной карточке нужен примерно 1 ход на этап. Заход — период от
# выдачи карточки агенту до выхода воркера. Счётчики живут в памяти службы:
# перезапуск службы их обнуляет (флаг остановки budget_exhausted хранится в базе).
max_state_turns = 2      # ходов подряд на одном этапе без продвижения. После
                         # второго такого хода карточка уходит в needs_human и
                         # встаёт на паузу (снимается POST /api/v1/<ID>/resume);
                         # третьего хода нет. Счётчик не сбрасывается при повторном
                         # входе в тот же этап: после resume карточка получит один ход.
max_turns = 12           # ходов за один заход: 4 этапа на самом длинном пути × (1 + max_attempts) = 12.
                         # Исчерпан без конца работы — карточка в needs_human, флаг
                         # budget_exhausted: сама не продолжится; сброс —
                         # POST /api/v1/<ID>/reset-budget (S4-09). Проект не примет
                         # значение меньше 4 × (1 + max_attempts) и меньше числа активных
                         # статусов доски (5; иначе ядро не примет WORKFLOW.md);
                         # зацикливание держит max_state_turns.
max_total_turns = 20     # ходов по карточке за всё время работы службы, по всем
                         # заходам (откат check.py начинает новый заход, счёт
                         # продолжается). Исчерпан — то же, что у max_turns.
max_attempts = 2         # возвратов назад по активным состояниям (Verify ->
                         # In Progress и т.п.), в том числе когда этап не выполнил
                         # контракт. Возврат номер max_attempts + 1 переводит
                         # карточку в Blocked. Откаты check.py сюда не входят:
                         # их считает [checks] max_check_failures.
"""


def fail(message: str) -> int:
    print(f"project-new: отказ: {message}", file=sys.stderr)
    return 1


def git_ok(*args: str) -> subprocess.CompletedProcess[str]:
    return subprocess.run(["git", *args], capture_output=True, text=True, check=False)


def nearest_existing(path: Path) -> Path:
    while not path.exists():
        path = path.parent
    return path


def toml_str(value: str) -> str:
    return json.dumps(value, ensure_ascii=False)


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(prog="project-new", description=__doc__.splitlines()[0])
    parser.add_argument("name")
    parser.add_argument("--repo", required=True)
    parser.add_argument("--base", required=True)
    parser.add_argument("--prefix", required=True)
    parser.add_argument("--port", required=True, type=int)
    parser.add_argument("--root", default=str(pc.DEFAULT_ROOT))
    args = parser.parse_args(argv)

    if not pc.NAME_RE.match(args.name):
        return fail(f"имя {args.name!r} не подходит под ^[a-z0-9][a-z0-9-]*$")
    if not pc.PREFIX_RE.match(args.prefix):
        return fail(f"префикс {args.prefix!r} не подходит под ^[A-Z][A-Z0-9]{{1,9}}$")
    if not 1 <= args.port <= 65535:
        return fail(f"порт {args.port} вне 1..65535")
    root = Path(args.root).expanduser().absolute()
    board = root / args.name
    if board.exists() or board.is_symlink():
        return fail(f"папка {board} уже есть; перезаписывать не буду")

    repo = Path(args.repo).expanduser().absolute()
    top = git_ok("-C", str(repo), "rev-parse", "--show-toplevel")
    if top.returncode != 0 or Path(top.stdout.strip()).resolve() != repo.resolve():
        return fail(f"{repo} — не корень git-репозитория")
    repo = repo.resolve()
    if git_ok("-C", str(repo), "check-ref-format", "--branch", args.base).returncode != 0 \
            or args.base.startswith("-"):
        return fail(f"имя ветки {args.base!r} некорректно")
    if git_ok("-C", str(repo), "show-ref", "--verify", "--quiet",
              f"refs/heads/{args.base}").returncode != 0:
        return fail(f"в {repo} нет ветки refs/heads/{args.base}")
    # REPORT-09, item 17: inside another repository git silently uses it.
    outer = nearest_existing(board.parent)
    probe = git_ok("-C", str(outer), "rev-parse", "--show-toplevel")
    if probe.returncode == 0:
        return fail(f"папка доски оказалась бы внутри git-репозитория {probe.stdout.strip()}; "
                    "выбери другой --root")

    for other, data in pc.other_projects(root):
        if data.get("port") == args.port:
            return fail(f"порт {args.port} уже занят проектом {other.name}")
        if data.get("id_prefix") == args.prefix:
            return fail(f"префикс {args.prefix} уже занят проектом {other.name}")

    claude = shutil.which("claude")
    if not claude:
        return fail("команда claude не найдена (which claude)")
    python = Path(sys.executable).absolute()
    if subprocess.run([str(python), "-c", "import symphony"], capture_output=True,
                      check=False).returncode != 0:
        return fail(f"{python} не видит пакет symphony: запусти project-new тем Python, "
                    "в который установлен оркестратор")
    symphony = python.parent / "symphony"
    if not symphony.is_file():
        found = shutil.which("symphony")
        if not found:
            return fail(f"не найден symphony рядом с {python} и в PATH")
        symphony = Path(found).absolute()

    try:
        board.mkdir(parents=True)
    except OSError as exc:
        return fail(f"не создать {board}: {exc}")
    try:
        create(board, args, repo, python, symphony, Path(claude).absolute())
    except BaseException as exc:
        shutil.rmtree(board, ignore_errors=True)
        if isinstance(exc, (pc.ProjectError, OSError, subprocess.CalledProcessError)):
            return fail(str(exc))
        raise
    print(f"Создана папка доски {board}\n"
          f"Дальше: заполни {board}/setup.sh, {board}/test.sh и [checks] в project.toml, "
          f"затем проверка и замер:\n"
          f"  {python} {pc.OURS_DIR / 'bin' / 'project-doctor'} {args.name} --root {root}\n"
          f"и запуск службы:\n"
          f"  {symphony} service start {board}/WORKFLOW.md")
    return 0


def create(board: Path, args, repo: Path, python: Path, symphony: Path, claude: Path) -> None:
    subprocess.run([str(symphony), "board", "init", str(board / pc.BOARD_DIR)],
                   check=True, capture_output=True)
    # `board init` always adds a sample Todo card; a running service would
    # dispatch it to a real agent.
    (board / pc.BOARD_DIR / "DEMO-001.md").unlink(missing_ok=True)
    for name in (pc.ARTIFACTS_DIR, pc.WIKI_DIR):
        (board / name).mkdir()
    pc.ensure_state_dir(board)
    (board / pc.EXCLUDE_FILE).write_text(pc.exclude_text(args.prefix), encoding="utf-8")
    for name, text in (("setup.sh", SETUP_SH), ("test.sh", TEST_SH)):
        script = board / name
        summarize = shlex.quote(str(pc.OURS_DIR / "hooks" / "summarize.py"))
        script.write_text(text.format(board=board, summarize=summarize), encoding="utf-8")
        script.chmod(0o755)
    (board / "card-template.md").write_text(
        CARD_TEMPLATE.format(board=board, prefix=args.prefix), encoding="utf-8")
    (board / pc.PROJECT_FILE).write_text(PROJECT_TOML.format(
        name=toml_str(args.name), repo=toml_str(str(repo)), base=toml_str(args.base),
        prefix=toml_str(args.prefix), prefix_raw=args.prefix, port=args.port,
        python=toml_str(str(python)), symphony=toml_str(str(symphony)),
        claude=toml_str(str(claude)),
    ), encoding="utf-8")
    project = pc.load_project(board)
    text = pc.render_workflow(board, project)
    pc.sync_claude_settings(board, project)
    pc.sync_board_prompts(board, project)
    (board / "WORKFLOW.md").write_text(text, encoding="utf-8")


if __name__ == "__main__":
    sys.exit(main())
