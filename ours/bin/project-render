#!/usr/bin/env python3
"""Re-render WORKFLOW.md of a project board from the shared template (TASK-K08a).

    project-render <name> [--root <dir>]

Prints the diff between the old and the new file, then writes the new one.
"""

from __future__ import annotations

import argparse
import difflib
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "hooks"))

import project_config as pc  # noqa: E402


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(prog="project-render", description=__doc__.splitlines()[0])
    parser.add_argument("name")
    parser.add_argument("--root", default=str(pc.DEFAULT_ROOT))
    args = parser.parse_args(argv)
    if not pc.NAME_RE.match(args.name):
        print(f"project-render: имя {args.name!r} некорректно", file=sys.stderr)
        return 1
    board = Path(args.root).expanduser().absolute() / args.name
    target = board / "WORKFLOW.md"
    try:
        project = pc.load_project(board)
        if project["project"]["name"] != args.name:
            raise pc.ProjectError(
                f"в {board / pc.PROJECT_FILE} имя {project['project']['name']!r}, а не {args.name!r}"
            )
        new = pc.render_workflow(board, project)
        old = target.read_text(encoding="utf-8") if target.exists() else ""
    except (pc.ProjectError, OSError) as exc:
        print(f"project-render: отказ: {exc}", file=sys.stderr)
        return 1
    if new == old:
        print(f"{target}: без изменений")
        return 0
    sys.stdout.writelines(difflib.unified_diff(
        old.splitlines(keepends=True), new.splitlines(keepends=True),
        fromfile=f"{target} (было)", tofile=f"{target} (стало)",
    ))
    tmp = target.with_name(".WORKFLOW.md.tmp")
    tmp.write_text(new, encoding="utf-8")
    tmp.replace(target)
    print(f"{target}: обновлён")
    return 0


if __name__ == "__main__":
    sys.exit(main())
