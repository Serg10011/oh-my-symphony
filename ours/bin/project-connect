#!/usr/bin/env python3
"""Project-chat connector. The host owns review/authorize/serve; a chat uses request."""
import argparse
import asyncio
import hmac
import json
import os
from pathlib import Path
import secrets
import subprocess
import sys
import time
import urllib.error
import urllib.request

from aiohttp import web

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "hooks"))
import project_connect as connect  # noqa: E402


def response(data, *, status=200):
    return web.json_response(data, status=status, headers={"Cache-Control": "no-store"})


def application(root):
    async def handle(req):
        if req.headers.get("Origin") or req.content_type != "application/json":
            return response(connect.refusal("local_client_required"), status=403)
        auth = req.headers.get("Authorization", "").partition(" ")
        if auth[0] != "Symphony" or not auth[2]:
            return response(connect.refusal("unauthorized"), status=403)
        try:
            data = await req.read()
            raw = connect.decode(data)
            challenge = req.headers.get("X-Symphony-Challenge", "")
            grant, token = connect.authenticate(raw, root, challenge, auth[2], data)
            result = await asyncio.to_thread(connect.connect, raw, root, grant)
        except web.HTTPRequestEntityTooLarge:
            return response(connect.refusal("request_too_large"), status=413)
        except connect.ConnectError as exc:
            reason = str(exc)
            return response(connect.refusal(reason), status=403 if reason == "unauthorized" else 409)
        except (OSError, ValueError, TypeError, KeyError, RuntimeError, subprocess.SubprocessError,
                connect.pc.ProjectError, connect.api_session.SessionError):
            # Configs, command lines and credentials may occur in exceptions.
            return response(connect.refusal("local_configuration_error"), status=409)
        body = json.dumps(result, ensure_ascii=False).encode()
        return web.Response(body=body, content_type="application/json", headers={"Cache-Control": "no-store",
            "X-Symphony-Proof": connect.signature(token, "reply", challenge, body)})

    app = web.Application(client_max_size=connect.MAX_REQUEST)
    app.router.add_post("/v1/connect", handle)
    return app


def client(port, credential, data):
    token = json.loads(connect.read_private(credential))["token"]
    challenge = str(int(time.time())) + "-" + secrets.token_hex(16)
    request = urllib.request.Request(f"http://127.0.0.1:{port}/v1/connect", data=data,
        headers={"Authorization": "Symphony " + connect.signature(token, "request", challenge, data),
                 "X-Symphony-Challenge": challenge, "Content-Type": "application/json"})
    # A local capability must never follow a proxy or redirect to another host.
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}), connect.NoRedirect())
    try:
        stream = opener.open(request, timeout=105)
    except urllib.error.HTTPError as exc:
        if exc.code not in (403, 409, 413):
            raise connect.ConnectError("connector_unavailable") from exc
        stream = exc
    with stream:
        body = stream.read(connect.MAX_REQUEST + 1)
        if stream.status != 200:
            reason = connect.decode(body).get("reason", "")
            if not isinstance(reason, str) or not reason.isascii() or not reason.replace("_", "").isalnum() or len(reason) > 64:
                reason = "connector_unavailable"
            raise connect.ConnectError(reason)
        if not hmac.compare_digest(stream.headers.get("X-Symphony-Proof", ""),
                                   connect.signature(token, "reply", challenge, body)):
            raise connect.ConnectError("unverified_connector_reply")
        return connect.decode(body)


def main():
    cli = argparse.ArgumentParser(description=__doc__)
    sub = cli.add_subparsers(dest="action", required=True)
    for name in ("review", "authorize", "serve", "request"):
        op = sub.add_parser(name)
        if name != "request":
            op.add_argument("--root", type=Path, default=connect.pc.DEFAULT_ROOT, help="trusted host board directory")
        if name in ("serve", "request"):
            op.add_argument("--port", type=int, default=8792, help="local connector port")
        if name == "authorize":
            op.add_argument("--expect", required=True, help="approval_id shown by review")
        if name == "request":
            op.add_argument("--credential", required=True, type=Path, help="private credential of this project")
    args = cli.parse_args()
    os.umask(0o077)
    try:
        if args.action != "request":
            root = connect.host_root(args.root)
        if hasattr(args, "port") and not 1 <= args.port <= 65535:
            raise connect.ConnectError("invalid_port")
        if args.action == "serve":
            connect.private_dir(root / ".connections")
            web.run_app(application(root), host="127.0.0.1", port=args.port, access_log=None)
            return 0
        data = sys.stdin.buffer.read(connect.MAX_REQUEST + 1)
        raw = connect.decode(data)
        if args.action == "request":
            result = client(args.port, args.credential, data)
        elif args.action == "review":
            result = {"status": "needs_owner_approval", **connect.review(raw, root)}
        else:
            result = connect.authorize(raw, root, args.expect)
    except connect.ConnectError as exc:
        result = connect.refusal(str(exc))
    except (OSError, ValueError, KeyError, RuntimeError, subprocess.SubprocessError):
        result = connect.refusal("local_configuration_error")
    print(json.dumps(result, ensure_ascii=False))
    return int(result["status"] == "refused")


if __name__ == "__main__":
    sys.exit(main())
