#!/usr/bin/env python3
"""Deliver the result of a card to GitHub (TASK-S4-27).

    deliver push <ID> [--root DIR] [--main DIR] [--gh PATH]
    deliver merged <ID> [--root DIR] [--main DIR]

Exit codes: 0 done, 1 refusal (nothing changed), 2 error. The logic lives in ours/hooks/deliver.py.
"""

from __future__ import annotations

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "hooks"))

import deliver  # noqa: E402

if __name__ == "__main__":
    sys.exit(deliver.run())
