#!/usr/bin/env python3
"""Finish creating draft subtasks from a saved API plan."""

import argparse
import json
from pathlib import Path
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "hooks"))

import api_board  # noqa: E402
import api_session  # noqa: E402
import project_config as pc  # noqa: E402
from symphony import api_team  # noqa: E402
from symphony.errors import SymphonyError  # noqa: E402
from symphony.workflow import WorkflowState  # noqa: E402


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("workflow", type=Path)
    parser.add_argument("--recover", required=True, metavar="CARD")
    args = parser.parse_args()
    try:
        workflow = args.workflow.resolve(strict=True)
        project = pc.load_project(workflow.parent)
        config, error = WorkflowState(workflow).reload()
        if error or not config or not project["api_team"] or not api_team.uses_board_queue(config, "api-team"):
            raise api_board.BoardError("api_plan_not_configured")
        settings = workflow.parent / project["api_team"]["settings_file"]
        board = api_board.Board(settings, api_team.board_context(config, "api-team", args.recover))
        result = board.recover_plan()
        print(json.dumps({key: result[key] for key in ("identifier", "status", "reason", "plan")},
                         ensure_ascii=False))
        return 0 if result["plan"]["status"] == "ready" else 1
    except (api_board.BoardError, api_session.SessionError, pc.ProjectError, SymphonyError, OSError) as exc:
        reason = str(exc) if isinstance(exc, (api_board.BoardError, api_session.SessionError)) else "api_plan_not_recoverable"
        print(json.dumps({"status": "refused", "reason": reason}))
        return 1


if __name__ == "__main__":
    sys.exit(main())
