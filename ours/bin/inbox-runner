#!/usr/bin/env python3
"""Command queue for the chat assistant (TASK-S4-02).

    inbox-runner [--main DIR] [--worktree-root DIR] [--interval SEC] [--once] [--gh PATH] [--osascript PATH]

Executes only <code>.run, <code>.test and <code>.merge files from
<main>/tmp_workspaces/inbox/. The logic lives in ours/hooks/inbox_runner.py.
"""

from __future__ import annotations

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "hooks"))

import inbox_runner  # noqa: E402

if __name__ == "__main__":
    sys.exit(inbox_runner.run())
