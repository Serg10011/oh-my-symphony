#!/usr/bin/env python3
"""Record targeted checks or bind cards to one approved release PR."""

import argparse
import json
import sys
from pathlib import Path

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "hooks"))

import api_board  # noqa: E402
import api_candidate  # noqa: E402
import api_group_release  # noqa: E402
import api_session  # noqa: E402
import project_config as pc  # noqa: E402
from symphony import api_team  # noqa: E402
from symphony.errors import SymphonyError  # noqa: E402
from symphony.workflow import WorkflowState  # noqa: E402


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("workflow", type=Path)
    parser.add_argument("--pr", type=int)
    parser.add_argument("--head")
    parser.add_argument("--card", required=True, action="append")
    parser.add_argument("--offer", help="record the preview with this approved fingerprint")
    parser.add_argument("--verified-release", type=Path, metavar="REPORT",
                        help="reuse the saved full checks of the exact merged release")
    parser.add_argument("--before-fixes", metavar="COMMIT",
                        help="first show the inclusion of card results in the parent of a reviewed fix commit")
    parser.add_argument("--ready", metavar="COMMIT", help="record the targeted checks of one candidate")
    parser.add_argument("--checks", help="short summary of the completed targeted checks")
    args = parser.parse_args(argv)
    if args.ready is not None:
        if (len(args.card) != 1 or args.checks is None
                or any(v is not None for v in (args.pr, args.head, args.offer, args.verified_release, args.before_fixes))):
            parser.error("--ready requires one --card and --checks and cannot be combined with release options")
    elif args.pr is None or args.head is None or args.checks is not None:
        parser.error("the release preview requires --pr and --head")
    elif args.before_fixes is not None and args.verified_release is None:
        parser.error("--before-fixes requires --verified-release")
    try:
        workflow = args.workflow.resolve(strict=True)
        config = pc.load_project(workflow.parent)
        parsed, error = WorkflowState(workflow).reload()
        if error or not parsed or not config["api_team"] or not api_team.uses_board_queue(parsed, "api-team"):
            raise api_group_release.ReleaseError("group_release_destination_invalid")
        settings = workflow.parent / config["api_team"]["settings_file"]
        boards = [api_board.Board(settings, api_team.board_context(parsed, "api-team", ident))
                  for ident in args.card]
        if args.ready is not None:
            result = api_group_release.record_review(boards[0], args.ready, args.checks)
        elif args.offer is None:
            result = api_group_release.preview(boards, args.pr, args.head, verified_release=args.verified_release,
                                               before_fixes=args.before_fixes)
        else:
            result = api_group_release.record(boards, args.pr, args.head, args.offer,
                                              verified_release=args.verified_release, before_fixes=args.before_fixes)
        print(json.dumps(result, ensure_ascii=False))
        return 0
    except (api_board.BoardError, api_candidate.CandidateError, api_session.SessionError, pc.ProjectError,
            SymphonyError, OSError, KeyError, TypeError, ValueError) as exc:
        reason = str(exc) if isinstance(exc, api_session.SessionError) else "group_release_unavailable"
        print(json.dumps({"status": "refused", "reason": reason}, ensure_ascii=False))
        return 1


if __name__ == "__main__":
    sys.exit(main())
