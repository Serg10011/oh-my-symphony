#!/usr/bin/env python3
"""Preview or record the cards belonging to one approved release PR."""

import argparse
import json
import sys
from pathlib import Path

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "hooks"))

import api_board  # noqa: E402
import api_candidate  # noqa: E402
import api_group_release  # noqa: E402
import api_session  # noqa: E402
import project_config as pc  # noqa: E402
from symphony import api_team  # noqa: E402
from symphony.errors import SymphonyError  # noqa: E402
from symphony.workflow import WorkflowState  # noqa: E402


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("workflow", type=Path)
    parser.add_argument("--pr", required=True, type=int)
    parser.add_argument("--head", required=True)
    parser.add_argument("--card", required=True, action="append")
    parser.add_argument("--offer", help="record the preview with this approved fingerprint")
    args = parser.parse_args(argv)
    try:
        workflow = args.workflow.resolve(strict=True)
        config = pc.load_project(workflow.parent)
        parsed, error = WorkflowState(workflow).reload()
        if error or not parsed or not config["api_team"] or not api_team.uses_board_queue(parsed, "api-team"):
            raise api_group_release.ReleaseError("group_release_destination_invalid")
        settings = workflow.parent / config["api_team"]["settings_file"]
        boards = [api_board.Board(settings, api_team.board_context(parsed, "api-team", ident))
                  for ident in args.card]
        if args.offer is None:
            result = api_group_release.preview(boards, args.pr, args.head)
        else:
            result = api_group_release.record(boards, args.pr, args.head, args.offer)
        print(json.dumps(result, ensure_ascii=False))
        return 0
    except (api_board.BoardError, api_candidate.CandidateError, api_session.SessionError, pc.ProjectError,
            SymphonyError, OSError, KeyError, TypeError, ValueError) as exc:
        reason = str(exc) if isinstance(exc, api_session.SessionError) else "group_release_unavailable"
        print(json.dumps({"status": "refused", "reason": reason}, ensure_ascii=False))
        return 1


if __name__ == "__main__":
    sys.exit(main())
