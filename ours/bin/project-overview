#!/usr/bin/env python3
"""Serve the local read-only project overview or print one JSON snapshot."""

import sys
from pathlib import Path

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "hooks"))

import project_overview  # noqa: E402

if __name__ == "__main__":
    sys.exit(project_overview.run())
